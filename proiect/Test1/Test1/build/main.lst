 175:Core/Src/main.c ****   /* USER CODE END 2 */
 176:Core/Src/main.c **** 
 177:Core/Src/main.c ****   /* Infinite loop */
 178:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 179:Core/Src/main.c ****   
 180:Core/Src/main.c **** 
 181:Core/Src/main.c ****   /*********************************** main loop *************************************************/
 182:Core/Src/main.c ****   while (1)
 183:Core/Src/main.c ****   {
 184:Core/Src/main.c ****     /* USER CODE END WHILE */
 185:Core/Src/main.c **** 
 186:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 187:Core/Src/main.c ****     if( HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET ) {     // PORTC.13 ==0 means button
 188:Core/Src/main.c ****         HAL_Delay(25);                                                 // wait 25 milliseconds
 189:Core/Src/main.c ****         if( HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET ) { // then read again for debou
 190:Core/Src/main.c ****           while( HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET); // wait for button releas
 191:Core/Src/main.c ****           User_B_Pressed = 1;
 192:Core/Src/main.c ****           printf("USER\n\r");
 193:Core/Src/main.c ****         }  
 194:Core/Src/main.c ****     }
 195:Core/Src/main.c ****      
 196:Core/Src/main.c ****     switch(SM_State) {     // main State Machine
 197:Core/Src/main.c ****       case SM_START:
 198:Core/Src/main.c ****         printf("Code version %d.%d starting...\n\r", SW_VERSION/10, SW_VERSION%10);
 199:Core/Src/main.c ****         SM_State=SM_FAST_BLINK;
 200:Core/Src/main.c ****         break;
 201:Core/Src/main.c **** 
 202:Core/Src/main.c ****       case SM_FAST_BLINK:
 203:Core/Src/main.c ****         if(User_B_Pressed) {
 204:Core/Src/main.c ****           htim2.Init.Period = 300;    // change timer counter period 3x slower
ARM GAS  C:\Users\andre\AppData\Local\Temp\ccDZ0qTx.s 			page 5


 205:Core/Src/main.c ****           if (HAL_TIM_Base_Init(&htim2) != HAL_OK) Error_Handler();  // reinitialize timer
 206:Core/Src/main.c ****           User_B_Pressed = 0; // reset flag because it was processed
 207:Core/Src/main.c ****           SM_State = SM_SLOW_BLINK;
 208:Core/Src/main.c ****         }
 209:Core/Src/main.c ****         break;
 210:Core/Src/main.c **** 
 211:Core/Src/main.c ****       
 212:Core/Src/main.c ****       case SM_SLOW_BLINK:
 213:Core/Src/main.c ****         if(User_B_Pressed) {
 214:Core/Src/main.c ****           htim2.Init.Period = 100;  // timer counter period original value
 215:Core/Src/main.c ****           if (HAL_TIM_Base_Init(&htim2) != HAL_OK) Error_Handler(); // reinitialize timer
 216:Core/Src/main.c ****           User_B_Pressed = 0;
 217:Core/Src/main.c ****           SM_State = SM_FAST_BLINK;
 218:Core/Src/main.c ****         }
 219:Core/Src/main.c ****         break;
 220:Core/Src/main.c **** 
 221:Core/Src/main.c ****       default:  // this shouldn't happen
 222:Core/Src/main.c ****         SM_State = SM_START;        
 223:Core/Src/main.c ****     } // switch
 224:Core/Src/main.c **** 
 225:Core/Src/main.c ****   }
 226:Core/Src/main.c ****   /* USER CODE END 3 */
 227:Core/Src/main.c **** }
