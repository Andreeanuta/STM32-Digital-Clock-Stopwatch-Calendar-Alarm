  74:Core/Src/main.c **** /**
  75:Core/Src/main.c ****   * @brief  Retargets the C library printf function to the USART.
  76:Core/Src/main.c ****   * @param  None
  77:Core/Src/main.c ****   * @retval None
  78:Core/Src/main.c ****   */
  79:Core/Src/main.c **** PUTCHAR_PROTOTYPE
  80:Core/Src/main.c **** {
  81:Core/Src/main.c ****   HAL_UART_Transmit(&huart1, (uint8_t *)&ch, 1, 0xFFFF);
  82:Core/Src/main.c ****   return ch;
  83:Core/Src/main.c **** }
  84:Core/Src/main.c **** 
  85:Core/Src/main.c **** /* also redefine _write for printf*/
  86:Core/Src/main.c **** int _write(int fd, char * ptr, int len)
  87:Core/Src/main.c **** {
  88:Core/Src/main.c ****   HAL_UART_Transmit(&huart1, (uint8_t *) ptr, len, HAL_MAX_DELAY);
  89:Core/Src/main.c ****   return len;
  90:Core/Src/main.c **** }
